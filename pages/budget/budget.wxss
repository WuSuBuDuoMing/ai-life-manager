/* pages/budget/budget.wxss */

/* 总览卡片 */
.overview-card {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-bg-card));
  padding: 40rpx 32rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.overview-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: var(--color-border);
  margin: 0 40rpx;
  align-self: center;
}

.overview-amount {
  margin-top: 8rpx;
}

/* Tab栏 */
.tab-bar {
  background-color: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  padding: 16rpx 0;
  border-radius: 12rpx;
  color: var(--color-text-secondary);
  transition: all 0.3s;
}

.tab-active {
  background-color: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
}

.tab-content {
  min-height: 400rpx;
}

/* 排序 */
.sort-bar {
  padding: 8rpx 0;
}

.sort-option {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-left: 16rpx;
}

.sort-active {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

/* 账单记录 */
.record-card {
  padding: 24rpx;
}

.record-card:active {
  opacity: 0.85;
}

.record-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background-color: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-icon {
  font-size: 36rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-note {
  margin-top: 6rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-date {
  margin-top: 6rpx;
}

.record-amount {
  font-size: 32rpx;
}

/* 分类统计 */
.category-list {
  display: flex;
  flex-direction: column;
}

.category-item {
  padding-bottom: 12rpx;
}

.category-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}

/* 周趋势 */
.trend-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar-bg {
  width: 28rpx;
  height: 140rpx;
  background-color: var(--color-bg-input);
  border-radius: 14rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.trend-bar-fill {
  width: 100%;
  background: linear-gradient(to top, var(--color-primary), var(--color-success));
  border-radius: 14rpx;
  transition: height 0.5s ease;
}

/* 预算 */
.budget-overview-card {
  padding: 48rpx 32rpx;
}

.budget-ring-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background-color: var(--color-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  animation: slideUp 0.3s ease;
}

.modal-close {
  font-size: 36rpx;
  color: var(--color-text-hint);
  padding: 8rpx 16rpx;
}

/* 类型切换 */
.type-switch {
  background-color: var(--color-bg-input);
  border-radius: 12rpx;
  padding: 6rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.type-btn-active {
  background-color: var(--color-danger);
  color: #FFFFFF;
  font-weight: 600;
}

.type-btn-active-income {
  background-color: var(--color-success);
  color: #FFFFFF;
  font-weight: 600;
}

/* 分类选项 */
.category-option {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background-color: var(--color-bg-input);
  border: 2rpx solid transparent;
}

.category-option-active {
  background-color: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 600;
}

/* 表单 */
.form-input {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background-color: var(--color-bg-input);
  font-size: 28rpx;
}

/* 加载 */
.loading-wrapper {
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
