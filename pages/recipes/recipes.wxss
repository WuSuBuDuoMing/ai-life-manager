/* pages/recipes/recipes.wxss */
.page-container { min-height: 100vh; background-color: var(--color-bg); padding: 0 32rpx; }

/* 分类标签 */
.category-scroll { white-space: nowrap; }
.category-list { display: inline-flex; gap: 12rpx; padding: 8rpx 0; }
.category-chip {
  display: inline-flex; padding: 12rpx 24rpx; border-radius: 24rpx;
  font-size: 24rpx; background: var(--color-bg-card, #fff);
  color: var(--color-text-secondary, #888); border: 1rpx solid var(--color-border, #e0e0e0);
  flex-shrink: 0;
}
.category-active {
  background: var(--color-primary, #4CAF50); color: #fff;
  border-color: var(--color-primary, #4CAF50);
}

/* 视图切换 */
.view-toggle {
  padding: 12rpx 20rpx; border-radius: 20rpx;
  background: var(--color-bg-card, #fff);
  border: 1rpx solid var(--color-border, #e0e0e0);
  flex-shrink: 0; margin-left: 12rpx;
}

/* 菜谱网格 */
.recipe-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.recipe-card {
  width: calc(50% - 8rpx); padding: 20rpx; box-sizing: border-box;
  position: relative;
}
.recipe-card:active { opacity: 0.8; }
.recipe-compact { padding: 16rpx; }
.recipe-card-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 12rpx;
}
.recipe-card-icon { font-size: 48rpx; }
.favorite-btn { padding: 8rpx; font-size: 28rpx; }
.recipe-card-name {
  font-size: 28rpx; color: var(--color-text-primary, #2C2C2C);
  display: block; margin-bottom: 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.recipe-card-meta {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 8rpx;
}
.recipe-card-tags {
  display: flex; flex-wrap: wrap; gap: 8rpx;
}
.tag-mini {
  font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 12rpx;
  background: var(--color-bg-input, #F7F3F0);
  color: var(--color-text-secondary, #888);
}

/* 难度标签 */
.difficulty-tag {
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 10rpx;
  font-weight: 600;
}
.difficulty-easy { background: #E8F5E9; color: #4CAF50; }
.difficulty-medium { background: #FFF3E0; color: #FF9800; }
.difficulty-hard { background: #FFEBEE; color: #EF5350; }

/* 详情弹窗 */
.detail-modal {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--color-bg-card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh; overflow-y: auto;
  padding: 32rpx;
}
.detail-header {
  display: flex; align-items: center;
  margin-bottom: 24rpx; padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-divider, #F5F0EB);
}
.detail-icon { font-size: 64rpx; }
.close-btn { padding: 16rpx; }
.detail-section { margin-bottom: 24rpx; }
.ingredient-list { padding-left: 8rpx; }
.ingredient-item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 0;
}
.ingredient-dot {
  color: var(--color-primary, #4CAF50); font-size: 32rpx; font-weight: 700;
}
.step-list { display: flex; flex-direction: column; gap: 16rpx; }
.step-item {
  display: flex; align-items: flex-start; gap: 16rpx;
}
.step-number {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--color-primary, #4CAF50); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; flex-shrink: 0;
  margin-top: 4rpx;
}
.tips-section {
  background: var(--color-bg-input, #F7F3F0);
  padding: 20rpx; border-radius: 16rpx;
}
.detail-footer { margin-top: 16rpx; }

/* 加载状态 */
.loading-state { padding: 16rpx 0; }

/* 烹饪计时器 */
.timer-section {
  background: var(--color-bg-input, #F7F3F0);
  border-radius: 16rpx;
  padding: 24rpx;
}

.timer-display {
  text-align: center;
  padding: 32rpx 0;
}

.timer-time {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--color-primary, #4CAF50);
  font-variant-numeric: tabular-nums;
}

.timer-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.timer-preset-btn {
  padding: 16rpx 24rpx;
  background: var(--color-bg-card, #fff);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-primary, #2C2C2C);
  border: 1rpx solid var(--color-border, #e0e0e0);
}

.timer-preset-btn:active {
  background: var(--color-primary-light, #E8F5E9);
  border-color: var(--color-primary, #4CAF50);
}

.timer-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-top: 16rpx;
}

.dark .timer-section {
  background: var(--color-bg-input, #2D2D4A);
}
