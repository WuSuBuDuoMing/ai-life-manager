/* pages/chores/chores.wxss */
.page-container { min-height: 100vh; background-color: var(--color-bg); padding: 0 32rpx; }

/* 排行榜 */
.leaderboard-scroll { white-space: nowrap; }
.leaderboard-list { display: inline-flex; gap: 16rpx; padding: 8rpx 0; }
.leaderboard-item {
  display: inline-flex; flex-direction: column; align-items: center;
  min-width: 140rpx; padding: 20rpx 16rpx; gap: 8rpx;
  background: var(--color-bg-input, #F7F3F0); border-radius: 20rpx;
}
.leaderboard-item:active { opacity: 0.7; }
.rank-badge {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700; color: #fff;
  background: #ccc;
}
.rank-0 { background: #FFD700; }
.rank-1 { background: #C0C0C0; }
.rank-2 { background: #CD7F32; }
.member-avatar { font-size: 36rpx; }
.member-name { color: var(--color-text-primary, #2C2C2C); }
.member-points { color: var(--color-primary, #4CAF50); }

/* Tab切换 */
.tabs {
  background: var(--color-bg-card, #fff);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.tab-item {
  padding: 16rpx 0;
  border-radius: 12rpx;
  color: var(--color-text-secondary, #888);
  transition: all 0.2s;
}
.tab-active {
  background: var(--color-primary, #4CAF50);
  color: #fff !important;
  font-weight: 600;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  left: 32rpx; right: 32rpx; bottom: 140rpx;
  z-index: 50;
}

/* 轮值表 */
.schedule-item {
  display: flex; align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider, #F5F0EB);
}
.schedule-item:last-child { border-bottom: none; }

/* 加载状态 */
.loading-state { padding: 16rpx 0; }

/* 统计概览 */
.stats-overview { margin-top: 8rpx; }
