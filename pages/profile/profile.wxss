/* pages/profile/profile.wxss */

/* 用户信息区域 */
.user-header {
  position: relative;
  margin-bottom: 24rpx;
  margin-top: -24rpx;
  margin-left: -32rpx;
  margin-right: -32rpx;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  z-index: 0;
}

.user-info {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 40rpx;
}

.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar { width: 100%; height: 100%; }
.user-avatar-placeholder { font-size: 56rpx; }
.user-name { font-size: 36rpx; color: #FFFFFF; }
.user-desc { color: rgba(255, 255, 255, 0.85); }

.reminder-badge {
  position: relative;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.badge-icon { font-size: 36rpx; }
.badge-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #EF5350;
  border: 3rpx solid #fff;
}

/* 统计数据 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.stat-item {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx !important;
  box-sizing: border-box;
}

.stat-emoji { font-size: 32rpx; margin-bottom: 8rpx; }
.stat-val { font-size: 28rpx; margin-bottom: 4rpx; }
.stat-lbl { font-size: 20rpx; }

/* 菜单分组 */
.menu-group { margin-bottom: 24rpx; }
.menu-group-card { padding: 0; overflow: hidden; }

.menu-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-divider, #F5F0EB);
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background-color: var(--color-bg-input, #F7F3F0); }

.menu-icon { font-size: 36rpx; width: 48rpx; text-align: center; margin-right: 20rpx; }
.menu-title { font-size: 30rpx; color: var(--color-text-primary, #2C2C2C); }
.menu-badge { margin-right: 12rpx; }
.menu-arrow { font-size: 32rpx; color: var(--color-text-hint, #bbb); }

/* 版本信息 */
.version-info { padding: 40rpx 0 20rpx; }

/* 生活积分卡片 */
.score-card { background: linear-gradient(135deg, #E8F5E9, #fff); }
.score-breakdown { display: flex; flex-direction: column; gap: 16rpx; }
.score-item { padding: 0; }
