/* pages/search/search.wxss */
.page-container {
  min-height: 100vh; background-color: var(--color-bg);
  display: flex; flex-direction: column;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 32rpx;
  background: var(--color-bg-card, #fff);
  border-bottom: 1rpx solid var(--color-divider, #F5F0EB);
}
.search-input-wrap {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--color-bg-input, #F7F3F0);
  border-radius: 32rpx; padding: 12rpx 24rpx;
}
.search-icon { font-size: 28rpx; }
.search-input {
  flex: 1; height: 56rpx; font-size: 28rpx;
  color: var(--color-text-primary, #2C2C2C);
}
.clear-btn {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--color-border, #e0e0e0);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-text-secondary, #888);
}

/* 搜索内容区 */
.search-content {
  flex: 1; padding: 0 32rpx; overflow-y: auto;
}

/* 区块 */
.section {
  margin-top: 32rpx;
}

/* 标签列表 */
.tag-list {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.history-tag {
  padding: 12rpx 24rpx; border-radius: 24rpx;
  background: var(--color-bg-card, #fff);
  color: var(--color-text-secondary, #888);
  border: 1rpx solid var(--color-border, #e0e0e0);
}
.history-tag:active { opacity: 0.7; }
.hot-tag {
  padding: 12rpx 24rpx; border-radius: 24rpx;
  background: var(--color-secondary-light, #FFF3E0);
  color: var(--color-secondary, #FF9800);
}
.hot-tag:active { opacity: 0.7; }

/* 结果统计 */
.result-summary {
  padding: 24rpx 0 8rpx;
}

/* 结果分组 */
.result-group {
  margin-bottom: 24rpx;
}
.group-header {
  display: flex; align-items: center; gap: 8rpx;
  padding: 16rpx 0 12rpx;
}
.group-icon { font-size: 28rpx; }

/* 结果项 */
.result-item { margin-bottom: 8rpx; }
.result-item:active { opacity: 0.7; }
.result-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  margin-right: 16rpx; flex-shrink: 0;
}

/* 加载 */
.loading-wrap { padding: 24rpx 0; }

/* 提示 */
.tips-section {
  text-align: center; padding: 40rpx 0;
}

/* 关键词高亮 */
.text-highlight {
  color: var(--color-primary, #4CAF50);
  font-weight: 700;
  background: var(--color-primary-light, #E8F5E9);
  padding: 0 4rpx;
  border-radius: 4rpx;
}

.dark .text-highlight {
  background: var(--color-primary-light, #1B3A1E);
}
