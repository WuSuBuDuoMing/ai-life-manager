/* pages/assistant/assistant.wxss */
.page-container {
  min-height: 100vh; background-color: var(--color-bg);
  display: flex; flex-direction: column;
}

/* 顶部标题 */
.assistant-header {
  padding: 20rpx 32rpx;
  background: var(--color-bg-card, #fff);
  border-bottom: 1rpx solid var(--color-divider, #F5F0EB);
}
.header-icon {
  font-size: 48rpx; margin-right: 16rpx;
}
.clear-btn {
  padding: 12rpx 24rpx; border-radius: 16rpx;
  background: var(--color-bg-input, #F7F3F0);
}

/* 聊天滚动区 */
.chat-scroll {
  flex: 1; overflow-y: auto;
  padding: 0 32rpx;
}

/* 快捷问题 */
.quick-section {
  padding: 32rpx 0;
}
.quick-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.quick-item {
  display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 16rpx; border-radius: 16rpx;
  background: var(--color-bg-card, #fff);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  width: calc(25% - 12rpx); box-sizing: border-box;
}
.quick-item:active { transform: scale(0.95); opacity: 0.8; }
.quick-icon { font-size: 36rpx; }

/* 消息布局 */
.message-wrapper {
  display: flex; flex-direction: column;
  margin-bottom: 24rpx; max-width: 85%;
}
.msg-left { align-self: flex-start; }
.msg-right { align-self: flex-end; align-items: flex-end; }

/* 头像 */
.msg-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--color-primary-light, #E8F5E9);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; margin-bottom: 8rpx;
}

/* 气泡 */
.msg-bubble {
  padding: 20rpx 24rpx; border-radius: 24rpx;
  max-width: 100%; word-break: break-all;
}
.bubble-assistant {
  background: var(--color-bg-card, #fff);
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.bubble-user {
  background: var(--color-primary, #4CAF50);
  color: #fff; border-bottom-right-radius: 8rpx;
}
.msg-content {
  font-size: 28rpx; line-height: 1.7;
  white-space: pre-wrap;
}
.bubble-user .msg-content { color: #fff; }
.msg-time {
  font-size: 20rpx; opacity: 0.5;
  margin-top: 8rpx; display: block;
}
.bubble-user .msg-time { text-align: right; }

/* 建议按钮 */
.suggestions {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-top: 12rpx;
}
.suggestion-chip {
  padding: 10rpx 20rpx; border-radius: 20rpx;
  background: var(--color-primary-light, #E8F5E9);
  color: var(--color-primary, #4CAF50);
  border: 1rpx solid var(--color-primary, #4CAF50);
}
.suggestion-chip:active { opacity: 0.7; }

/* 模块标签 */
.module-tag {
  margin-top: 8rpx; padding: 4rpx 0;
}

/* 打字动画 */
.typing-dots {
  display: flex; gap: 8rpx; padding: 8rpx 0;
}
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--color-text-hint, #bbb);
  animation: dotBounce 1.4s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* 输入栏 */
.input-bar {
  padding: 16rpx 32rpx;
  background: var(--color-bg-card, #fff);
  border-top: 1rpx solid var(--color-divider, #F5F0EB);
}
.input-wrap {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--color-bg-input, #F7F3F0);
  border-radius: 40rpx; padding: 8rpx 12rpx 8rpx 28rpx;
}
.chat-input {
  flex: 1; height: 64rpx; font-size: 28rpx;
  color: var(--color-text-primary, #2C2C2C);
}
.send-btn {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--color-bg-input, #F7F3F0);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.send-active {
  background: var(--color-primary, #4CAF50);
}
.send-active .send-icon { color: #fff; }
.send-icon {
  font-size: 32rpx; font-weight: 700;
  color: var(--color-text-hint, #bbb);
}
