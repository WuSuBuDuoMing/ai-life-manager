/**
 * task-card 样式
 * 设计：圆角卡片，左侧复选框，中间标题+信息行
 * completed 状态：标题灰色+删除线，整体淡化
 * 支持优先级颜色和状态标签
 */

/* 卡片容器 */
.task-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: opacity 0.3s ease, transform 0.2s ease;
}

page.dark .task-card {
  background-color: #2C2C2E;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.task-card:active {
  transform: scale(0.98);
}

/* 已完成状态 */
.task-card.completed {
  opacity: 0.6;
}

.task-card.completed .task-title {
  color: #AAAAAA;
  text-decoration: line-through;
}

/* ==================== 复选框 ==================== */
.task-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 4rpx;
  transition: all 0.2s ease;
}

.task-checkbox.checked {
  background-color: #4CAF50;
  border-color: #4CAF50;
}

.checkbox-icon {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

/* ==================== 内容区域 ==================== */
.task-content {
  flex: 1;
  overflow: hidden;
}

.task-title-row {
  margin-bottom: 8rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

page.dark .task-title {
  color: #F5F5F5;
}

/* ==================== 信息行 ==================== */
.task-info-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

/* 到期日期 */
.task-due {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.due-icon {
  font-size: 22rpx;
  line-height: 1;
}

.due-text {
  font-size: 22rpx;
  color: #999999;
}

/* 负责人标签 */
.task-assignee {
  padding: 4rpx 14rpx;
  background-color: rgba(76, 175, 80, 0.1);
  border-radius: 20rpx;
}

.assignee-text {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: 500;
}

/* ==================== 优先级标签 ==================== */
.task-priority {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.priority-low {
  background-color: rgba(158, 158, 158, 0.1);
}

.priority-low .priority-text {
  color: #9E9E9E;
}

.priority-normal {
  background-color: rgba(76, 175, 80, 0.1);
}

.priority-normal .priority-text {
  color: #4CAF50;
}

.priority-high {
  background-color: rgba(255, 152, 0, 0.1);
}

.priority-high .priority-text {
  color: #FF9800;
}

.priority-urgent {
  background-color: rgba(244, 67, 54, 0.1);
}

.priority-urgent .priority-text {
  color: #F44336;
}

.priority-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* ==================== 状态标签 ==================== */
.task-status {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.status-pending {
  background-color: rgba(158, 158, 158, 0.1);
}

.status-pending .status-text {
  color: #9E9E9E;
}

.status-in_progress {
  background-color: rgba(33, 150, 243, 0.1);
}

.status-in_progress .status-text {
  color: #2196F3;
}

.status-completed {
  background-color: rgba(76, 175, 80, 0.1);
}

.status-completed .status-text {
  color: #4CAF50;
}

.status-text {
  font-size: 22rpx;
  font-weight: 500;
}
