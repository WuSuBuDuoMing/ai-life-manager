<!--
  food-card 组件
  功能：食品卡片，展示食品名称、数量、存储位置、保质期状态
  新鲜=绿色边框，临期(<3天)=橙色，过期=红色
-->
<view class="food-card status-{{expiryStatus}}">
  <!-- 左侧状态指示条 -->
  <view class="food-status-bar bar-{{expiryStatus}}"></view>

  <!-- 内容区域 -->
  <view class="food-content">
    <!-- 第一行：食品名 + 数量 -->
    <view class="food-header">
      <text class="food-name">{{item.name}}</text>
      <text class="food-quantity" wx:if="{{item.quantity}}">{{item.quantity}}{{item.unit || '个'}}</text>
    </view>

    <!-- 第二行：分类 + 存储位置 -->
    <view class="food-info-row">
      <view class="food-category" wx:if="{{item.category}}">
        <text class="category-text">{{item.category}}</text>
      </view>
      <view class="food-location" wx:if="{{item.storageLocation}}">
        <text class="location-text">📍 {{item.storageLocation}}</text>
      </view>
    </view>

    <!-- 第三行：保质期状态标签 -->
    <view class="food-expiry-row">
      <view class="expiry-badge badge-{{expiryStatus}}">
        <text class="badge-text">{{expiryText}}</text>
      </view>
      <text class="food-expiry-date" wx:if="{{item.expiryDate}}">保质期至 {{item.expiryDate}}</text>
    </view>
  </view>

  <!-- 右侧操作按钮 -->
  <view class="food-actions">
    <view class="action-btn add-btn" catchtap="onAddToShopping">
      <text class="action-icon">🛒</text>
    </view>
    <view class="action-btn edit-btn" catchtap="onEdit">
      <text class="action-icon">✎</text>
    </view>
    <view class="action-btn delete-btn" catchtap="onDelete">
      <text class="action-icon">✕</text>
    </view>
  </view>
</view>
