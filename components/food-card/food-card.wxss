/**
 * food-card 样式
 * 设计：左侧彩色状态条+内容区+右侧操作按钮
 * 保质期状态：fresh=绿色边框, expiring=橙色, expired=红色
 */

/* 卡片容器 */
.food-card {
  display: flex;
  align-items: stretch;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  border-left: 6rpx solid transparent;
  transition: transform 0.2s ease;
}

page.dark .food-card {
  background-color: #2C2C2E;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.food-card:active {
  transform: scale(0.98);
}

/* 保质期状态边框 */
.food-card.status-fresh {
  border-left-color: #4CAF50;
}

.food-card.status-expiring {
  border-left-color: #FF9800;
}

.food-card.status-expired {
  border-left-color: #F44336;
}

/* 左侧状态条（备用，主要通过border-left实现） */
.food-status-bar {
  width: 6rpx;
  flex-shrink: 0;
}

.bar-fresh {
  background-color: #4CAF50;
}

.bar-expiring {
  background-color: #FF9800;
}

.bar-expired {
  background-color: #F44336;
}

/* 内容区域 */
.food-content {
  flex: 1;
  padding: 20rpx;
  overflow: hidden;
}

.food-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.food-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

page.dark .food-name {
  color: #F5F5F5;
}

.food-quantity {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF9800;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 信息行 */
.food-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.food-category {
  padding: 2rpx 12rpx;
  background-color: rgba(76, 175, 80, 0.1);
  border-radius: 12rpx;
}

.category-text {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: 500;
}

.food-location {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.location-text {
  font-size: 22rpx;
  color: #999999;
}

/* 保质期行 */
.food-expiry-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.expiry-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.badge-fresh {
  background-color: rgba(76, 175, 80, 0.1);
}

.badge-fresh .badge-text {
  color: #4CAF50;
}

.badge-expiring {
  background-color: rgba(255, 152, 0, 0.1);
}

.badge-expiring .badge-text {
  color: #FF9800;
}

.badge-expired {
  background-color: rgba(244, 67, 54, 0.1);
}

.badge-expired .badge-text {
  color: #F44336;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 600;
}

.food-expiry-date {
  font-size: 22rpx;
  color: #BBBBBB;
}

/* 操作按钮 */
.food-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
}

.action-btn:active {
  opacity: 0.6;
}

.action-icon {
  font-size: 24rpx;
  line-height: 1;
}

.add-btn {
  background-color: rgba(76, 175, 80, 0.1);
}

.edit-btn {
  background-color: rgba(33, 150, 243, 0.1);
}

.delete-btn {
  background-color: rgba(244, 67, 54, 0.1);
}
