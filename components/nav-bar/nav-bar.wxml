<!--
  nav-bar 组件
  功能：自定义导航栏，适配状态栏高度
  支持返回按钮、首页按钮、自定义背景色和文字颜色
  状态栏高度通过系统信息获取
-->
<view class="nav-bar" style="background-color: {{bgColor}};">
  <!-- 状态栏高度占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 标题栏 -->
  <view class="title-bar" style="height: {{titleBarHeight}}px;">
    <!-- 左侧：返回按钮 -->
    <view class="nav-left" wx:if="{{showBack}}" bindtap="onBack">
      <view class="back-btn">
        <text class="back-icon" style="color: {{textColor}};">‹</text>
      </view>
    </view>

    <!-- 左侧占位（无返回按钮时） -->
    <view class="nav-left" wx:if="{{!showBack}}">
      <view class="nav-placeholder"></view>
    </view>

    <!-- 中间：标题 -->
    <view class="nav-center">
      <text class="nav-title" style="color: {{textColor}};">{{title}}</text>
    </view>

    <!-- 右侧：首页按钮 -->
    <view class="nav-right" wx:if="{{showHome}}" bindtap="onHome">
      <view class="home-btn">
        <text class="home-icon" style="color: {{textColor}};">⌂</text>
      </view>
    </view>

    <!-- 右侧占位（无首页按钮时） -->
    <view class="nav-right" wx:if="{{!showHome}}">
      <view class="nav-placeholder"></view>
    </view>
  </view>
</view>

<!-- 占位元素，防止内容被固定导航栏遮挡 -->
<view class="nav-bar-placeholder" style="height: {{totalHeight}}px;"></view>
